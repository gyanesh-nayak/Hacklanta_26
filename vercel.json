{
  "services": {
    "musiggle-karaoke": {
      "root": ".",
      "entrypoint": "app:app",
      "buildCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "musiggle-karaoke"
      }
    }
  ]
}
